#!/usr/bin/env bash
# discover — Monitor CLI wrapper (the main entry point for auto-discovery)
#
# Dispatches to monitor.py (topic web search), rss.py (feed watcher),
# and report.py (discovery suggestion generator).
#
# Flags are documented in CLAUDE.md and must remain stable —
# tools/monitor/setup-cron.sh points at this script.
#
# Usage:
#   ./tools/monitor/discover                  Check all topics for new content
#   ./tools/monitor/discover --ingest         Check + auto-ingest new content
#   ./tools/monitor/discover --report         Generate discovery suggestion report
#   ./tools/monitor/discover --feeds          Check RSS feeds for matches
#   ./tools/monitor/discover --all            Run everything (topics + feeds + report)
#   ./tools/monitor/discover --topic 'RAG'    Only check matching topic (scopes monitor.py)
#   ./tools/monitor/discover --days 7         Look back N days (topics + feeds window)
#   ./tools/monitor/discover --help           Show this help
#
# Notes:
#   - --topic only applies to topic monitoring (monitor.py); it is ignored for
#     feeds and report runs.
#   - --days translates to monitor.py's --days and rss.py's --since.
#   - --all is orchestration (run the three operations); it is NOT forwarded to
#     the underlying modules (where --all has a different, module-local meaning).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

MONITOR_PY="$SCRIPT_DIR/monitor.py"
RSS_PY="$SCRIPT_DIR/rss.py"
REPORT_PY="$SCRIPT_DIR/report.py"

# Colors (disabled when stdout is not a tty)
if [[ -t 1 ]]; then
    GREEN=$'\033[0;32m'
    BLUE=$'\033[0;34m'
    YELLOW=$'\033[1;33m'
    RED=$'\033[0;31m'
    NC=$'\033[0m'
else
    GREEN=""
    BLUE=""
    YELLOW=""
    RED=""
    NC=""
fi

# --- Defaults ---
DO_TOPICS=false
DO_INGEST=false
DO_REPORT=false
DO_FEEDS=false
DO_ALL=false
TOPIC_FILTER=""
DAYS_BACK=""
# Catch-all for sub-module flags we don't parse directly (e.g. --dry-run).
EXTRA_ARGS=()

usage() {
    cat <<EOF
${GREEN}discover${NC} — Auto-discovery and topic monitoring

Usage:
  ./tools/monitor/discover                  Check all topics for new content
  ./tools/monitor/discover --ingest         Check + auto-ingest new content
  ./tools/monitor/discover --report         Generate discovery suggestion report
  ./tools/monitor/discover --feeds          Check RSS feeds for matches
  ./tools/monitor/discover --all            Run everything (topics + feeds + report)
  ./tools/monitor/discover --topic 'RAG'    Only check matching topic (monitor.py only)
  ./tools/monitor/discover --days 7         Look back N days (topics + feeds)
  ./tools/monitor/discover --help           Show this help

Flags combine:
  ./tools/monitor/discover --feeds --report
  ./tools/monitor/discover --ingest --days 7 --topic 'RAG'

Passing extra flags to sub-modules:
  Unknown flags are routed to the single selected module. They are only
  accepted when exactly one of the topic run / --feeds / --report modes
  is active; a multi-module run (e.g. --all) rejects passthrough flags to
  avoid ambiguity. Use '--' to separate wrapper flags from module-local
  flags that collide with wrapper names (e.g. rss.py's own --all):

  ./tools/monitor/discover --feeds -- --all     # forward --all to rss.py
  ./tools/monitor/discover --report -- --output out.md
  ./tools/monitor/discover -- --dry-run         # --dry-run to monitor.py
EOF
}

# --- Parse arguments ---
if [[ $# -eq 0 ]]; then
    DO_TOPICS=true
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        --ingest)
            DO_TOPICS=true
            DO_INGEST=true
            shift
            ;;
        --report)
            DO_REPORT=true
            shift
            ;;
        --feeds)
            DO_FEEDS=true
            shift
            ;;
        --all)
            DO_ALL=true
            shift
            ;;
        --topic)
            if [[ $# -lt 2 ]]; then
                echo "${RED}error:${NC} --topic requires an argument" >&2
                exit 2
            fi
            if [[ -z "$2" ]]; then
                echo "${RED}error:${NC} --topic requires a non-empty argument" >&2
                exit 2
            fi
            # --topic is a modifier for monitor.py. Do NOT unilaterally enable
            # topic dispatch here — doing so would turn `--report --topic X`
            # or `--feeds --topic X` into state-mutating topic checks. Topics
            # get auto-enabled later only when no module selector was chosen.
            TOPIC_FILTER="$2"
            shift 2
            ;;
        --topic=*)
            TOPIC_FILTER="${1#--topic=}"
            if [[ -z "$TOPIC_FILTER" ]]; then
                echo "${RED}error:${NC} --topic requires a non-empty argument" >&2
                exit 2
            fi
            shift
            ;;
        --days)
            if [[ $# -lt 2 ]]; then
                echo "${RED}error:${NC} --days requires an integer argument" >&2
                exit 2
            fi
            if ! [[ "$2" =~ ^[1-9][0-9]*$ ]]; then
                echo "${RED}error:${NC} --days expects a positive integer (>= 1), got '$2'" >&2
                exit 2
            fi
            DAYS_BACK="$2"
            shift 2
            ;;
        --days=*)
            DAYS_BACK="${1#--days=}"
            if ! [[ "$DAYS_BACK" =~ ^[1-9][0-9]*$ ]]; then
                echo "${RED}error:${NC} --days expects a positive integer (>= 1), got '$DAYS_BACK'" >&2
                exit 2
            fi
            shift
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        --)
            shift
            while [[ $# -gt 0 ]]; do
                EXTRA_ARGS+=("$1")
                shift
            done
            ;;
        *)
            # Preserve unknown flags so they can be routed after parsing.
            EXTRA_ARGS+=("$1")
            shift
            ;;
    esac
done

if $DO_ALL; then
    # --all is orchestration: run topics + feeds + report. It does NOT
    # enable ingestion — users must pass --ingest explicitly (or combine
    # --all --ingest) to opt into state-mutating auto-ingest.
    DO_TOPICS=true
    DO_REPORT=true
    DO_FEEDS=true
fi

# Modifier-only invocations should behave like the default topic check.
if ! $DO_TOPICS && ! $DO_FEEDS && ! $DO_REPORT; then
    DO_TOPICS=true
fi

MONITOR_EXTRA_ARGS=()
RSS_EXTRA_ARGS=()
REPORT_EXTRA_ARGS=()
if [[ ${#EXTRA_ARGS[@]} -gt 0 ]]; then
    selected_modules=0
    if $DO_TOPICS; then
        selected_modules=$((selected_modules + 1))
    fi
    if $DO_FEEDS; then
        selected_modules=$((selected_modules + 1))
    fi
    if $DO_REPORT; then
        selected_modules=$((selected_modules + 1))
    fi

    if [[ $selected_modules -gt 1 ]]; then
        echo "${RED}error:${NC} extra flags require a single target module; got: ${EXTRA_ARGS[*]}" >&2
        exit 2
    fi

    # Single-module invocations forward unknown flags to the corresponding
    # sub-module (e.g. --output <path> for report.py, --dry-run for monitor.py).
    if $DO_REPORT; then
        REPORT_EXTRA_ARGS=("${EXTRA_ARGS[@]}")
    elif $DO_FEEDS; then
        RSS_EXTRA_ARGS=("${EXTRA_ARGS[@]}")
    else
        MONITOR_EXTRA_ARGS=("${EXTRA_ARGS[@]}")
    fi
fi

# --- Verify dependencies ---
missing_modules=()
if $DO_TOPICS && [[ ! -f "$MONITOR_PY" ]]; then
    missing_modules+=("monitor.py")
fi
if $DO_FEEDS && [[ ! -f "$RSS_PY" ]]; then
    missing_modules+=("rss.py")
fi
if $DO_REPORT && [[ ! -f "$REPORT_PY" ]]; then
    missing_modules+=("report.py")
fi
if [[ ${#missing_modules[@]} -gt 0 ]]; then
    echo "${RED}error:${NC} missing required sub-module(s): ${missing_modules[*]}" >&2
    echo "       expected under: $SCRIPT_DIR" >&2
    exit 3
fi

if ! command -v python3 >/dev/null 2>&1; then
    echo "${RED}error:${NC} python3 is required but not found on PATH" >&2
    exit 4
fi

# --- Header ---
echo "${BLUE}========================================${NC}"
echo "${BLUE}  KB Auto-Discovery & Monitoring${NC}"
echo "${BLUE}========================================${NC}"
if [[ -n "$DAYS_BACK" ]]; then
    echo "  Window: last ${DAYS_BACK} day(s)"
fi
if [[ -n "$TOPIC_FILTER" ]]; then
    echo "  Topic filter: ${TOPIC_FILTER}"
fi
echo ""

# Track overall status. "No new sources" is not a failure.
OVERALL_EXIT=0
record_status() {
    # monitor.py returns 1 when no new sources — treat that as success.
    local rc="$1"
    local module="$2"
    if [[ "$rc" -eq 0 ]]; then
        return 0
    fi
    if [[ "$module" == "monitor.py" && "$rc" -eq 1 ]]; then
        # "no new sources" — not a failure
        return 0
    fi
    echo "${YELLOW}warn:${NC} ${module} exited with status ${rc}" >&2
    # Preserve the FIRST non-zero exit code so later failures don't overwrite
    # the original root cause.
    if [[ "$OVERALL_EXIT" -eq 0 ]]; then
        OVERALL_EXIT=$rc
    fi
}

# --- Topic monitoring ---
if $DO_TOPICS; then
    echo "${GREEN}[topics] Topic Monitor${NC}"
    echo "---"
    monitor_args=()
    if $DO_INGEST; then
        monitor_args+=("--ingest")
    fi
    if [[ -n "$DAYS_BACK" ]]; then
        monitor_args+=("--days" "$DAYS_BACK")
    fi
    if [[ -n "$TOPIC_FILTER" ]]; then
        monitor_args+=("--topic" "$TOPIC_FILTER")
    fi
    # Forward unknown flags (e.g. --dry-run) to monitor.py.
    if [[ ${#MONITOR_EXTRA_ARGS[@]} -gt 0 ]]; then
        monitor_args+=("${MONITOR_EXTRA_ARGS[@]}")
    fi
    set +e
    python3 "$MONITOR_PY" "${monitor_args[@]}"
    rc=$?
    set -e
    record_status "$rc" "monitor.py"
    echo ""
fi

# --- RSS feeds ---
if $DO_FEEDS; then
    echo "${GREEN}[feeds] RSS Feed Watcher${NC}"
    echo "---"
    rss_args=()
    # rss.py uses --since, not --days; translate.
    if [[ -n "$DAYS_BACK" ]]; then
        rss_args+=("--since" "$DAYS_BACK")
    fi
    if [[ ${#RSS_EXTRA_ARGS[@]} -gt 0 ]]; then
        rss_args+=("${RSS_EXTRA_ARGS[@]}")
    fi
    set +e
    python3 "$RSS_PY" "${rss_args[@]}"
    rc=$?
    set -e
    record_status "$rc" "rss.py"
    echo ""
fi

# --- Report ---
if $DO_REPORT; then
    echo "${GREEN}[report] Discovery Report${NC}"
    echo "---"
    # report.py does not accept --topic / --days; run it without them.
    # Forward any single-module passthrough flags (e.g. --output <path>).
    report_args=()
    if [[ ${#REPORT_EXTRA_ARGS[@]} -gt 0 ]]; then
        report_args+=("${REPORT_EXTRA_ARGS[@]}")
    fi
    set +e
    python3 "$REPORT_PY" "${report_args[@]}"
    rc=$?
    set -e
    record_status "$rc" "report.py"
    echo ""
fi

echo "${BLUE}========================================${NC}"
if [[ "$OVERALL_EXIT" -eq 0 ]]; then
    echo "${BLUE}  Done.${NC}"
else
    echo "${RED}  Done with errors (exit ${OVERALL_EXIT}).${NC}"
fi
echo "${BLUE}========================================${NC}"

exit "$OVERALL_EXIT"
