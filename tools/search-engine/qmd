#!/usr/bin/env bash
# qmd — Quick Markdown search for the LLM knowledge base wiki
# Designed to be called by Claude CLI as a tool.
# Usage: ./qmd "query" [--type concept|source|entity|comparison] [--top N]
#
# Output is concise markdown optimized for LLM consumption.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SEARCH_PY="${SCRIPT_DIR}/search.py"

if [ $# -eq 0 ]; then
    echo "Usage: qmd <query> [--type TYPE] [--top N]"
    echo ""
    echo "Search the wiki knowledge base."
    echo ""
    echo "Types: concept, source, entity, comparison"
    echo "Default: returns top 10 results across all types."
    exit 1
fi

# Pass all arguments through, always use LLM-friendly output
exec python3 "${SEARCH_PY}" "$@" --llm
