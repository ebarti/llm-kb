.DS_Store
.obsidian/workspace.json
.obsidian/workspace-mobile.json
*.pyc
__pycache__/
*.egg-info/
.env
.venv/
.idea/
tools/search-engine/.index/
tools/monitor/.logs/
tools/monitor/.state/

# Workspace data lives under $KB_WORKSPACES (default ~/kb-workspaces/), not in the repo.
# These directories are for standalone workspaces only; the install dir must stay code-only.
/wiki/
/raw/
/output/
/Clippings/
/.queue/

# Typed graph store (rebuilt on compile)
.graph.db
.graph.db-journal
.graph.db-wal
.graph.db-shm

# Eval harness produces fresh reports each run in CI; do not commit volatile
# artifacts (timestamps, per-question latencies, ranked lists). Historical
# timestamped snapshots are also ignored since CI uploads them as artifacts.
output/eval-*-latest.json
output/eval-*-latest.md
output/eval-retrieval-[0-9]*.json
output/eval-generation-[0-9]*.json
