#!/bin/bash
# kb — LLM Knowledge Base CLI
#
# A personal knowledge base powered by Claude CLI.
# All operations are natural language prompts routed through Claude.
#
# Usage:
#   ./kb research "transformers"          # deep research + ingest + compile
#   ./kb ingest https://example.com       # ingest specific URL
#   ./kb compile                          # recompile wiki from raw
#   ./kb ask "what is attention?"         # Q&A over the wiki
#   ./kb lint                             # health check + gap fill
#   ./kb search "query"                   # full-text search
#   ./kb slides "topic"                   # generate Marp slides
#   ./kb report "topic"                   # generate detailed report
#   ./kb compare "x" "y"                  # comparison article
#   ./kb entity "name"                    # create/update entity page
#   ./kb export [site|pdf|epub|bundle]    # export wiki
#   ./kb viz [graph|timeline|stats|canvas]# generate visualizations
#   ./kb discover                         # auto-discover new sources
#   ./kb test                             # run integrity tests
#   ./kb log [n]                          # show last n log entries
#   ./kb stats                            # quick wiki statistics
#   ./kb init                             # initialize new KB
#   ./kb serve                            # start search web UI
#   ./kb mcp                              # start MCP server
#   ./kb -i                               # interactive mode

set -euo pipefail

# ─── Timing ──────────────────────────────────────────────────────────────────
_KB_START_TIME=$(date +%s)

# ─── Environment & Defaults ──────────────────────────────────────────────────
KB_HOME="$(cd "$(dirname "$0")" && pwd)"   # Where kb is installed (tools, CLAUDE.md master copy)
KB_DIR="${KB_DIR:-$KB_HOME}"               # Active workspace (overridable via --dir or KB_DIR)
KB_MODEL="${KB_MODEL:-opus}"
KB_PERMISSION_MODE="${KB_PERMISSION_MODE:-bypassPermissions}"
KB_NO_COMMIT="${KB_NO_COMMIT:-0}"
KB_BUDGET="${KB_BUDGET:-200}"

# ─── Colors & Symbols ───────────────────────────────────────────────────────
if [[ -t 1 ]]; then
    BOLD='\033[1m'
    DIM='\033[2m'
    RESET='\033[0m'
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    BLUE='\033[0;34m'
    MAGENTA='\033[0;35m'
    CYAN='\033[0;36m'
    WHITE='\033[1;37m'
    SYM_OK="✓"
    SYM_FAIL="✗"
    SYM_ARROW="→"
    SYM_BULLET="•"
    SYM_WARN="⚠"
    SYM_INFO="ℹ"
    SYM_SPARK="⚡"
else
    BOLD="" DIM="" RESET=""
    RED="" GREEN="" YELLOW="" BLUE="" MAGENTA="" CYAN="" WHITE=""
    SYM_OK="[ok]" SYM_FAIL="[fail]" SYM_ARROW="->" SYM_BULLET="*"
    SYM_WARN="[warn]" SYM_INFO="[info]" SYM_SPARK="[!]"
fi

# ─── Helpers ─────────────────────────────────────────────────────────────────
msg()      { echo -e "${BLUE}${SYM_BULLET}${RESET} $*"; }
msg_ok()   { echo -e "${GREEN}${SYM_OK}${RESET} $*"; }
msg_warn() { echo -e "${YELLOW}${SYM_WARN}${RESET} $*"; }
msg_err()  { echo -e "${RED}${SYM_FAIL}${RESET} $*" >&2; }
msg_info() { echo -e "${CYAN}${SYM_INFO}${RESET} $*"; }
header()   { echo -e "\n${BOLD}${WHITE}$*${RESET}"; echo -e "${DIM}$(printf '%.0s─' $(seq 1 ${#1}))${RESET}"; }
progress() { echo -e "${MAGENTA}${SYM_SPARK}${RESET} ${DIM}$*${RESET}"; }

elapsed() {
    local end now dur
    now=$(date +%s)
    dur=$(( now - _KB_START_TIME ))
    if (( dur >= 60 )); then
        echo -e "\n${DIM}Completed in $((dur / 60))m $((dur % 60))s${RESET}"
    else
        echo -e "\n${DIM}Completed in ${dur}s${RESET}"
    fi
}

die() { msg_err "$@"; exit 1; }

need_arg() {
    [[ -n "${1:-}" ]] || die "Missing required argument. Run ${BOLD}./kb --help${RESET} for usage."
}

# ─── Flags ───────────────────────────────────────────────────────────────────
VERBOSE=0
DRY_RUN=0
NO_COMMIT="$KB_NO_COMMIT"
MODEL_OVERRIDE=""
BUDGET_OVERRIDE=""

parse_flags() {
    local args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --verbose|-v)   VERBOSE=1; shift ;;
            --dry-run)      DRY_RUN=1; shift ;;
            --no-commit)    NO_COMMIT=1; shift ;;
            --model)        shift; MODEL_OVERRIDE="${1:-}"; shift ;;
            --budget)       shift; BUDGET_OVERRIDE="${1:-}"; shift ;;
            --dir|-d)       shift; DIR_REQUEST="${1:-.}"; shift ;;
            --completions)  shift; gen_completions "${1:-bash}"; exit 0 ;;
            *)              args+=("$1"); shift ;;
        esac
    done
    set -- "${args[@]+"${args[@]}"}"
    # Re-export for the rest of the script
    _ARGS=("${args[@]+"${args[@]}"}")
}

# ─── Claude Runner ───────────────────────────────────────────────────────────
run_claude() {
    local prompt="$1"
    local model="${MODEL_OVERRIDE:-$KB_MODEL}"
    local perm="$KB_PERMISSION_MODE"

    if (( DRY_RUN )); then
        header "DRY RUN"
        echo -e "${DIM}Model:${RESET}  $model"
        echo -e "${DIM}Prompt:${RESET} $prompt"
        echo -e "${DIM}Budget:${RESET} ${BUDGET_OVERRIDE:-${KB_BUDGET:-default}}"
        return 0
    fi

    if (( VERBOSE )); then
        msg_info "Model: ${BOLD}$model${RESET}"
        msg_info "Permission mode: ${BOLD}$perm${RESET}"
        [[ -n "${BUDGET_OVERRIDE:-${KB_BUDGET:-}}" ]] && msg_info "Budget: ${BOLD}${BUDGET_OVERRIDE:-$KB_BUDGET}${RESET}"
    fi

    local claude_args=(
        --print
        --permission-mode "$perm"
        --model "$model"
        --effort max
    )
    if [[ -n "${BUDGET_OVERRIDE:-${KB_BUDGET:-}}" ]]; then
        claude_args+=(--max-turns "${BUDGET_OVERRIDE:-$KB_BUDGET}")
    fi

    claude "${claude_args[@]}" "$prompt"
}

# ─── Git Auto-Commit ─────────────────────────────────────────────────────────
auto_commit() {
    local label="${1:-update}"
    (( NO_COMMIT )) && return 0
    (( DRY_RUN )) && return 0

    if git -C "$KB_DIR" rev-parse --is-inside-work-tree &>/dev/null 2>&1; then
        if ! git -C "$KB_DIR" diff --quiet 2>/dev/null || \
           [[ -n "$(git -C "$KB_DIR" ls-files --others --exclude-standard 2>/dev/null)" ]]; then
            git -C "$KB_DIR" add -A && git -C "$KB_DIR" commit -q -m "kb: $label" 2>/dev/null
            msg_ok "Committed: ${DIM}kb: $label${RESET}"
        fi
    fi
}

# ─── Ensure directories exist ───────────────────────────────────────────────
ensure_dirs() {
    mkdir -p "$KB_DIR"/{raw,wiki/{_meta,concepts,sources,entities,comparisons},output/{reports,slides,images}}
}

