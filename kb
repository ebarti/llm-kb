# ─── new (create a named workspace) ─────────────────────────────────────────
cmd_new() {
    local name="${1:?Usage: kb new <name> [path]}"
    local base="${2:-$HOME/kb-workspaces}"
    local target="$base/$name"
    header "Creating workspace: $name"
    msg "Location: $target"
    cmd_init "$target"
    echo ""
    msg_info "To use this workspace:"
    echo -e "  ${GREEN}./kb --dir $target${RESET} research \"your topic\""
    echo -e "  ${GREEN}KB_DIR=$target ./kb${RESET} stats"
    echo -e "  ${GREEN}cd $target && open .${RESET}  ${DIM}# open in Obsidian${RESET}"
}

# ─── list workspaces ────────────────────────────────────────────────────────
cmd_workspaces() {
    header "Knowledge Base Workspaces"
    local base="${1:-$HOME/kb-workspaces}"

    # Always show the install-location workspace
    local install_count
    install_count=$(find "$KB_HOME/wiki" -name '*.md' -type f 2>/dev/null | wc -l | tr -d ' ')
    printf "  ${CYAN}%-30s${RESET} %6s articles  %s\n" "(default)" "$install_count" "$KB_HOME"

    # Show named workspaces
    if [[ -d "$base" ]]; then
        for dir in "$base"/*/; do
            [[ -d "$dir/wiki" ]] || continue
            local name count
            name=$(basename "$dir")
            count=$(find "$dir/wiki" -name '*.md' -type f 2>/dev/null | wc -l | tr -d ' ')
            printf "  ${GREEN}%-30s${RESET} %6s articles  %s\n" "$name" "$count" "$dir"
        done
    fi
    echo ""
    msg_info "Use ${GREEN}--dir <path>${RESET} to target a workspace, or ${GREEN}kb new <name>${RESET} to create one"
}

# ─── init ────────────────────────────────────────────────────────────────────
cmd_init() {
    header "Initializing Knowledge Base"
    local target="${1:-$KB_DIR}"

    if (( DRY_RUN )); then
        msg "Would create directory structure in: $target"
        return 0
    fi

    progress "Creating directory structure..."
    mkdir -p "$target"/{raw,wiki/{_meta,concepts,sources,entities,comparisons},output/{reports,slides,images},tools,templates,Clippings}

    # .gitignore
    if [[ ! -f "$target/.gitignore" ]]; then
        progress "Creating .gitignore..."
        cat > "$target/.gitignore" <<'GITIGNORE'
# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
.venv/

# Node
node_modules/

# Build artifacts
*.pdf
*.epub

# Obsidian
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Secrets
.env
GITIGNORE
        msg_ok "Created .gitignore"
    fi

    # Obsidian config
    if [[ ! -d "$target/.obsidian" ]]; then
        progress "Creating Obsidian configuration..."
        mkdir -p "$target/.obsidian"
        cat > "$target/.obsidian/app.json" <<'OBSIDIAN_APP'
{
  "strictLineBreaks": false,
  "showFrontmatter": true,
  "livePreview": true,
  "readableLineLength": true
}
OBSIDIAN_APP
        cat > "$target/.obsidian/appearance.json" <<'OBSIDIAN_THEME'
{
  "accentColor": "#7c5cbf",
  "theme": "obsidian"
}
OBSIDIAN_THEME
        msg_ok "Created Obsidian config"
    fi

    # CLAUDE.md — copy the full version from install location if available
    if [[ ! -f "$target/CLAUDE.md" ]]; then
        progress "Creating CLAUDE.md..."
        if [[ -f "$KB_HOME/CLAUDE.md" && "$target" != "$KB_HOME" ]]; then
            cp "$KB_HOME/CLAUDE.md" "$target/CLAUDE.md"
            msg_ok "Copied CLAUDE.md from $KB_HOME"
        else
            cat > "$target/CLAUDE.md" <<'CLAUDEMD'
# LLM Knowledge Base

You are operating an LLM-powered personal knowledge base. This is an Obsidian vault where YOU (the LLM) author and maintain all wiki content.

**You are a research agent first, a wiki compiler second, and a Q&A system third.**

## Directory Structure

```
raw/            → Raw ingested content (source of truth)
wiki/           → LLM-compiled wiki (YOU maintain this)
  _index.md     → Master index
  log.md        → Chronological operation log
  _meta/        → Metadata (summaries, links, manifest)
  concepts/     → Concept articles
  entities/     → Entity pages
  comparisons/  → Comparison articles
  sources/      → Per-source summaries
output/         → Generated outputs (reports, slides, images)
tools/          → Helper scripts
```

See the full CLAUDE.md in the kb install directory for detailed operation instructions.
CLAUDEMD
            msg_ok "Created CLAUDE.md"
        fi
    fi

    # Tools — copy from install location if available and target is different
    if [[ -d "$KB_HOME/tools" && "$target" != "$KB_HOME" && ! -d "$target/tools/search-engine" ]]; then
        progress "Copying tools from $KB_HOME..."
        cp -R "$KB_HOME/tools/" "$target/tools/"
        msg_ok "Copied tools/"
    fi

    # Templates — copy from install location
    if [[ -d "$KB_HOME/templates" && "$target" != "$KB_HOME" && ! -d "$target/templates" ]]; then
        cp -R "$KB_HOME/templates/" "$target/templates/"
        msg_ok "Copied templates/"
    fi

    # wiki/_index.md
    if [[ ! -f "$target/wiki/_index.md" ]]; then
        progress "Creating wiki index..."
        cat > "$target/wiki/_index.md" <<'INDEX'
---
title: "Knowledge Base Index"
type: index
last_updated: ""
---

# Knowledge Base Index

## Concepts

_No concept articles yet. Run `./kb research "<topic>"` to get started._

## Entities

## Sources

## Comparisons
INDEX
        msg_ok "Created wiki/_index.md"
    fi

    # wiki/log.md
    if [[ ! -f "$target/wiki/log.md" ]]; then
        cat > "$target/wiki/log.md" <<LOG
# Knowledge Base Log

## [$(date +%Y-%m-%d)] init | Knowledge base initialized
- Created directory structure
- Ready for research
LOG
        msg_ok "Created wiki/log.md"
    fi

    # wiki/_meta files
    for meta_file in summaries.md links.md manifest.md; do
        if [[ ! -f "$target/wiki/_meta/$meta_file" ]]; then
            echo "# ${meta_file%.md}" > "$target/wiki/_meta/$meta_file"
        fi
    done
    msg_ok "Created metadata files"

    # Git
    if [[ ! -d "$target/.git" ]]; then
        progress "Initializing git repository..."
        git -C "$target" init -q
        git -C "$target" add -A
        git -C "$target" commit -q -m "kb: initialize knowledge base"
        msg_ok "Initialized git repository"
    fi

    echo ""
    msg_ok "Knowledge base initialized at ${BOLD}$target${RESET}"
    msg_info "Get started: ${GREEN}./kb research \"your topic\"${RESET}"
}

# ─── stats ───────────────────────────────────────────────────────────────────
cmd_stats() {
    header "Knowledge Base Statistics"
    cd "$KB_DIR"

    # Helper: count .md files in a directory (non-recursive for specific dirs)
    count_md() {
        local dir="$1"
        if [[ -d "$dir" ]]; then
            find "$dir" -maxdepth 1 -name '*.md' -type f 2>/dev/null | wc -l | tr -d ' '
        else
            echo "0"
        fi
    }

    # Helper: word count for a directory (recursive)
    word_count() {
        local dir="$1"
        if [[ -d "$dir" ]]; then
            find "$dir" -name '*.md' -type f -exec cat {} + 2>/dev/null | wc -w | tr -d ' '
        else
            echo "0"
        fi
    }

    # Helper: last modified .md file
    last_modified() {
        local dir="$1"
        if [[ -d "$dir" ]]; then
            local f
            f=$(find "$dir" -name '*.md' -type f -print0 2>/dev/null | xargs -0 ls -t 2>/dev/null | head -1)
            if [[ -n "$f" ]]; then
                stat -f '%Sm' -t '%Y-%m-%d %H:%M' "$f" 2>/dev/null || stat --format='%y' "$f" 2>/dev/null | cut -d. -f1 || echo "—"
            else
                echo "—"
            fi
        else
            echo "—"
        fi
    }

    local raw_count concepts_count sources_count entities_count comparisons_count output_count
    raw_count=$(count_md raw)
    concepts_count=$(count_md wiki/concepts)
    sources_count=$(count_md wiki/sources)
    entities_count=$(count_md wiki/entities)
    comparisons_count=$(count_md wiki/comparisons)
    output_count=$(find output -name '*.md' -type f 2>/dev/null | wc -l | tr -d ' ')

    local total_wiki_files total_wiki_words total_raw_words
    total_wiki_files=$(find wiki -name '*.md' -type f 2>/dev/null | wc -l | tr -d ' ')
    total_wiki_words=$(word_count wiki)
    total_raw_words=$(word_count raw)

    local git_commits="—"
    if git rev-parse --is-inside-work-tree &>/dev/null 2>&1; then
        git_commits=$(git rev-list --count HEAD 2>/dev/null || echo "—")
    fi

    # Table
    printf "\n"
    printf "  ${BOLD}%-22s %8s %12s %20s${RESET}\n" "Section" "Files" "Words" "Last Modified"
    printf "  ${DIM}%-22s %8s %12s %20s${RESET}\n" "──────────────────────" "────────" "────────────" "────────────────────"
    printf "  ${CYAN}%-22s${RESET} %8s %12s %20s\n" "raw/" "$raw_count" "$total_raw_words" "$(last_modified raw)"
    printf "  ${CYAN}%-22s${RESET} %8s %12s %20s\n" "wiki/concepts/" "$concepts_count" "$(word_count wiki/concepts)" "$(last_modified wiki/concepts)"
    printf "  ${CYAN}%-22s${RESET} %8s %12s %20s\n" "wiki/sources/" "$sources_count" "$(word_count wiki/sources)" "$(last_modified wiki/sources)"
    printf "  ${CYAN}%-22s${RESET} %8s %12s %20s\n" "wiki/entities/" "$entities_count" "$(word_count wiki/entities)" "$(last_modified wiki/entities)"
    printf "  ${CYAN}%-22s${RESET} %8s %12s %20s\n" "wiki/comparisons/" "$comparisons_count" "$(word_count wiki/comparisons)" "$(last_modified wiki/comparisons)"
    printf "  ${CYAN}%-22s${RESET} %8s %12s %20s\n" "output/" "$output_count" "$(word_count output)" "$(last_modified output)"
    printf "  ${DIM}%-22s %8s %12s %20s${RESET}\n" "──────────────────────" "────────" "────────────" "────────────────────"
    printf "  ${BOLD}%-22s %8s %12s${RESET}\n" "TOTAL wiki" "$total_wiki_files" "$total_wiki_words"
    printf "\n"

    if [[ "$git_commits" != "—" ]]; then
        msg_info "Git commits: ${BOLD}$git_commits${RESET}"
    fi

    # Show top tags if we can parse them quickly
    if [[ -d wiki/concepts ]] && (( concepts_count > 0 )); then
        local tag_line
        tag_line=$(grep -h '^tags:' wiki/concepts/*.md 2>/dev/null | sed 's/tags://;s/\[//;s/\]//;s/"//g' | tr ',' '\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | sort | uniq -c | sort -rn | head -5 || true)
        if [[ -n "$tag_line" ]]; then
            echo -e "  ${BOLD}Top Tags${RESET}"
            echo "$tag_line" | while read -r count tag; do
                [[ -n "$tag" ]] && printf "    ${DIM}%3s${RESET} %s\n" "$count" "$tag"
            done
            echo ""
        fi
    fi
}

# ─── log ─────────────────────────────────────────────────────────────────────
cmd_log() {
    local log_file="$KB_DIR/wiki/log.md"
    if [[ ! -f "$log_file" ]]; then
        die "No log file found at $log_file"
    fi

    local n="${1:-10}"
    if [[ "$n" == "--all" || "$n" == "-a" ]]; then
        cat "$log_file"
        return 0
    fi

    # Extract entries (each starts with "## [")
    # Show the header + last n entries
    head -1 "$log_file"
    echo ""
    # Use awk to split on entry headers, keep last n
    awk -v n="$n" '
        /^## \[/ { entry_num++; entries[entry_num] = "" }
        { entries[entry_num] = entries[entry_num] "\n" $0 }
        END {
            start = entry_num - n + 1
            if (start < 1) start = 1
            for (i = start; i <= entry_num; i++) {
                print entries[i]
            }
        }
    ' "$log_file"
}

# ─── search ──────────────────────────────────────────────────────────────────
cmd_search() {
    need_arg "${1:-}"
    local query="$*"

    # Try the search engine first
    if [[ -f "$KB_DIR/tools/search-engine/search.py" ]]; then
        progress "Searching (search engine)..."
        if python3 "$KB_DIR/tools/search-engine/search.py" "$query" 2>/dev/null; then
            return 0
        fi
        msg_warn "Search engine unavailable, falling back to grep"
    fi

    # Fallback: use the existing search script or grep directly
    if [[ -x "$KB_DIR/tools/search.sh" ]]; then
        "$KB_DIR/tools/search.sh" "$query"
    else
        header "Search: $query"
        grep -ril --include='*.md' "$query" "$KB_DIR/wiki" "$KB_DIR/raw" 2>/dev/null | while read -r f; do
            local rel="${f#$KB_DIR/}"
            local matches
            matches=$(grep -ci "$query" "$f" 2>/dev/null || echo 0)
            echo -e "  ${CYAN}$rel${RESET} ${DIM}($matches matches)${RESET}"
            grep -ni -C 1 "$query" "$f" 2>/dev/null | head -6 | sed 's/^/    /'
            echo ""
        done
    fi
}

# ─── serve ───────────────────────────────────────────────────────────────────
cmd_serve() {
    local server="$KB_DIR/tools/search-engine/server.py"
    if [[ ! -f "$server" ]]; then
        die "Search engine server not found at $server"
    fi

    local port="${1:-8765}"
    header "Starting KB Search Server"
    msg_info "URL: ${BOLD}http://localhost:$port${RESET}"
    msg "Press Ctrl+C to stop"
    echo ""

    # Open browser after a short delay
    (sleep 1 && open "http://localhost:$port" 2>/dev/null || xdg-open "http://localhost:$port" 2>/dev/null) &

    python3 "$server" "$port"
}

# ─── mcp ─────────────────────────────────────────────────────────────────────
cmd_mcp() {
    local server="$KB_DIR/tools/mcp-server/server.py"
    if [[ ! -f "$server" ]]; then
        die "MCP server not found at $server"
    fi

    header "Starting MCP Server"
    python3 "$server" "$@"
}

# ─── test ────────────────────────────────────────────────────────────────────
cmd_test() {
    header "Running Integrity Tests"
    local test_script="$KB_DIR/tools/tests/check-integrity.py"
    if [[ -f "$test_script" ]]; then
        python3 "$test_script"
    else
        msg_warn "No test script found at $test_script"
        msg "Running basic checks..."
        echo ""

        local errors=0

        # Check required directories
        for dir in raw wiki wiki/_meta wiki/concepts wiki/sources wiki/entities wiki/comparisons output; do
            if [[ -d "$KB_DIR/$dir" ]]; then
                msg_ok "$dir/ exists"
            else
                msg_err "$dir/ missing"
                errors=$((errors + 1))
            fi
        done

        # Check required files
        for f in wiki/_index.md wiki/log.md wiki/_meta/summaries.md CLAUDE.md; do
            if [[ -f "$KB_DIR/$f" ]]; then
                msg_ok "$f exists"
            else
                msg_err "$f missing"
                errors=$((errors + 1))
            fi
        done

        # Check for orphan raw files (not in manifest)
        if [[ -f "$KB_DIR/wiki/_meta/manifest.md" ]]; then
            local raw_count manifest_entries orphans
            raw_count=$(find "$KB_DIR/raw" -name '*.md' -type f 2>/dev/null | wc -l | tr -d ' ')
            manifest_entries=$(grep -c 'raw/' "$KB_DIR/wiki/_meta/manifest.md" 2>/dev/null || echo 0)
            orphans=$((raw_count - manifest_entries))
            if (( orphans > 0 )); then
                msg_warn "$orphans raw file(s) not in manifest (uncompiled)"
            else
                msg_ok "All raw files tracked in manifest"
            fi
        fi

        # Check for broken wikilinks
        local broken=0
        while IFS= read -r link; do
            local target="${link%%|*}"  # strip display text
            target="${target#\[\[}"
            target="${target%\]\]}"
            if [[ ! -f "$KB_DIR/$target.md" && ! -f "$KB_DIR/wiki/$target.md" ]]; then
                (( VERBOSE )) && msg_warn "Broken link: [[$target]]"
                broken=$((broken + 1))
            fi
        done < <(grep -roh '\[\[[^]]*\]\]' "$KB_DIR/wiki" 2>/dev/null | sort -u)

        if (( broken > 0 )); then
            msg_warn "$broken broken wikilink(s) found"
        else
            msg_ok "No broken wikilinks"
        fi

        echo ""
        if (( errors == 0 )); then
            msg_ok "All basic checks passed"
        else
            msg_err "$errors error(s) found"
        fi
    fi
}

# ─── viz ─────────────────────────────────────────────────────────────────────
cmd_viz() {
    local viz_type="${1:-stats}"
    local viz_dir="$KB_DIR/tools/viz"

    case "$viz_type" in
        graph)
            if [[ -f "$viz_dir/graph.py" ]]; then
                progress "Generating knowledge graph..."
                python3 "$viz_dir/graph.py"
                msg_ok "Graph saved to output/images/"
            else
                die "graph.py not found in $viz_dir"
            fi
            ;;
        timeline)
            if [[ -f "$viz_dir/timeline.py" ]]; then
                progress "Generating timeline..."
                python3 "$viz_dir/timeline.py"
                msg_ok "Timeline saved to output/images/"
            else
                die "timeline.py not found in $viz_dir"
            fi
            ;;
        stats)
            if [[ -f "$viz_dir/stats.py" ]]; then
                progress "Generating stats visualization..."
                python3 "$viz_dir/stats.py"
                msg_ok "Stats saved to output/images/"
            else
                die "stats.py not found in $viz_dir"
            fi
            ;;
        canvas)
            if [[ -f "$viz_dir/canvas.py" ]]; then
                progress "Generating Obsidian canvas..."
                python3 "$viz_dir/canvas.py"
                msg_ok "Canvas updated"
            else
                die "canvas.py not found in $viz_dir"
            fi
            ;;
        all)
            if [[ -f "$viz_dir/generate-all.sh" ]]; then
                progress "Generating all visualizations..."
                bash "$viz_dir/generate-all.sh"
                msg_ok "All visualizations generated"
            else
                for vt in graph timeline stats canvas; do
                    cmd_viz "$vt" 2>/dev/null || true
                done
            fi
            ;;
        *)
            die "Unknown visualization type: $viz_type (try: graph, timeline, stats, canvas, all)"
            ;;
    esac
}

# ─── export ──────────────────────────────────────────────────────────────────
cmd_export() {
    local format="${1:-site}"
    local export_dir="$KB_DIR/tools/export"

    case "$format" in
        site)
            progress "Building static site..."
            if [[ -f "$export_dir/build-site.py" ]]; then
                python3 "$export_dir/build-site.py"
                msg_ok "Site built"
            else
                die "build-site.py not found"
            fi
            ;;
        pdf|epub)
            progress "Exporting to $format..."
            if command -v pandoc &>/dev/null; then
                local outfile="$KB_DIR/output/kb-export.$format"
                find "$KB_DIR/wiki" -name '*.md' -not -path '*/_meta/*' -type f | sort | xargs pandoc -o "$outfile" --metadata title="Knowledge Base Export"
                msg_ok "Exported to $outfile"
            else
                die "pandoc is required for $format export. Install with: brew install pandoc"
            fi
            ;;
        bundle)
            progress "Creating bundle..."
            local bundle="$KB_DIR/output/kb-bundle-$(date +%Y%m%d).tar.gz"
            tar -czf "$bundle" -C "$KB_DIR" wiki/ raw/ output/ CLAUDE.md 2>/dev/null
            msg_ok "Bundle created: $bundle"
            ;;
        *)
            die "Unknown export format: $format (try: site, pdf, epub, bundle)"
            ;;
    esac
}

# ─── Shell Completions ──────────────────────────────────────────────────────
gen_completions() {
    local shell="${1:-bash}"
    case "$shell" in
