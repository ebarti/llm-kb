#!/bin/bash
# kb — LLM Knowledge Base CLI (thin shim → Python implementation)
#
# The legacy bash implementation has been superseded by the Python CLI in
# tools/kb/. This wrapper exists only to keep the `./kb` entrypoint stable
# for users and tests. All real logic lives in tools/kb/cli.py.
#
# If python3 is unavailable we fail fast with a clear error rather than
# dropping back into a stale bash copy.

set -euo pipefail

KB_HOME="$(cd "$(dirname "$0")" && pwd)"
cd "$KB_HOME"

if ! command -v python3 >/dev/null 2>&1; then
    echo "kb: python3 not found on PATH; install Python 3 to use the kb CLI." >&2
    exit 1
fi

exec python3 -m tools.kb.cli "$@"
