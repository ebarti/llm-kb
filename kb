# ═══════════════════════════════════════════════════════════════════════════════
#  SMART ROUTING
# ═══════════════════════════════════════════════════════════════════════════════

smart_route() {
    local input="$*"

    # URL detection
    if [[ "$input" =~ ^https?:// ]]; then
        msg_info "Auto-routing to ${BOLD}ingest${RESET} (detected URL)"
        cmd_ingest "$input"
        return
    fi

    # Question detection
    local lower
    lower=$(echo "$input" | tr '[:upper:]' '[:lower:]')
    if [[ "$lower" =~ ^(what|how|why|when|who|is|are|can|does|did|will|should|which|where)[[:space:]] ]] || [[ "$input" == *"?" ]]; then
        msg_info "Auto-routing to ${BOLD}ask${RESET} (detected question)"
        cmd_ask "$input"
        return
    fi

    # Short phrase = research (3 words or fewer, no special chars)
    local word_count
    word_count=$(echo "$input" | wc -w | tr -d ' ')
    if (( word_count <= 3 )) && [[ ! "$input" == *"/"* ]]; then
        msg_info "Auto-routing to ${BOLD}research${RESET} (short phrase)"
        cmd_research "$input"
        return
    fi

    # Otherwise: free-form prompt
    cmd_freeform "$input"
}

# ═══════════════════════════════════════════════════════════════════════════════
#  MAIN
# ═══════════════════════════════════════════════════════════════════════════════

main() {
    # Parse global flags
    parse_flags "$@"
    set -- "${_ARGS[@]+"${_ARGS[@]}"}"

    # Resolve --dir: bare name → workspace under base dir; path → use as-is
    if [[ -n "${DIR_REQUEST:-}" ]]; then
        if [[ "$DIR_REQUEST" != */* ]]; then
            DIR_REQUEST="$HOME/kb-workspaces/$DIR_REQUEST"
        fi
        mkdir -p "$DIR_REQUEST"
        KB_DIR="$(cd "$DIR_REQUEST" && pwd)"
        if [[ ! -d "$KB_DIR/wiki" ]]; then
            msg_info "New workspace detected — initializing ${BOLD}$KB_DIR${RESET}"
            cmd_init "$KB_DIR"
        fi
    fi

    # Ensure we're in the KB directory
    cd "$KB_DIR"

    # No arguments = help
    if [[ $# -eq 0 ]]; then
        cmd_help
        exit 0
    fi

    # Ensure directories exist (except for init which creates them)
    if [[ "${1:-}" != "init" ]]; then
        ensure_dirs
    fi

    # Route command
    case "$1" in
        -h|--help|help)     cmd_help ;;
        -i|--interactive)   cmd_interactive ;;
        init)               shift; cmd_init "$@" ;;
        new)                shift; cmd_new "$@" ;;
        workspaces|ws)      shift; cmd_workspaces "$@" ;;
        research)           shift; cmd_research "$@" ;;
        ingest)             shift; cmd_ingest "$@" ;;
        compile)            cmd_compile ;;
        ask)                shift; cmd_ask "$@" ;;
        lint)               cmd_lint ;;
        search)             shift; cmd_search "$@" ;;
        slides)             shift; cmd_slides "$@" ;;
        report)             shift; cmd_report "$@" ;;
        compare)            shift; cmd_compare "$@" ;;
        entity)             shift; cmd_entity "$@" ;;
        export)             shift; cmd_export "$@" ;;
        viz)                shift; cmd_viz "$@" ;;
        discover)           cmd_discover ;;
        test)               cmd_test ;;
        log)                shift; cmd_log "$@" ;;
        stats)              cmd_stats ;;
        serve)              shift; cmd_serve "$@" ;;
        mcp)                shift; cmd_mcp "$@" ;;
        *)                  smart_route "$@" ;;
    esac

    local exit_code=$?

    # Show elapsed time (skip for trivial commands)
    case "${_ARGS[0]:-}" in
        -h|--help|help|stats|log|"") ;;
        *) elapsed ;;
    esac

    exit $exit_code
}

main "$@"
